# RailSentinel Dashboard Environment Configuration

# API Base URL - Leave empty to use local MSW mock handlers
# Set to your teammate's API URL when integrating real backends
# Example: VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# ETA API Configuration
# Base URL for Person 1's ETA prediction FastAPI service
# Example: VITE_ETA_API_BASE_URL=http://localhost:8000
VITE_ETA_API_BASE_URL=http://localhost:8000

# ETA API Mode: 'real' to use Person 1's FastAPI, 'mock' to use local MSW mock
# Options: 'real' | 'mock'
VITE_ETA_API_MODE=mock

# Demo Mode
# Set to 'true' to enable deterministic demo controller (Step 11)
VITE_DEMO_MODE=true

# Debug logging
VITE_DEBUG=false